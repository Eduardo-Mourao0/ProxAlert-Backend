generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PREMIUM
}

enum LogLevel {
  INFO
  WARN
  ERROR
}

model User {
  id               String   @id
  name             String
  email            String   @unique
  password         String
  refreshTokenHash String?
  plan             Plan     @default(FREE)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Log {
  id        String   @id @default(uuid())
  level     LogLevel
  message   String
  route     String?
  stack     String?
  createdAt DateTime @default(now())
}
